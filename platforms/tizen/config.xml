<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets"
    id="http://www.ecuavisa.com/ecuavisa"
    version="1.0.0"
    viewmodes="maximized">
    <tizen:application id="EcuavisaTV.Ecuavisa" package="EcuavisaTV" required_version="2.3"/>
    <content src="build/index.html"/>
    <icon src="build/icon.png"/>
  <name>Ecuavisa</name>
  <feature name="http://tizen.org/feature/screen.size.normal.1080.1920" />
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/application.launch"/>
    <tizen:setting screen-orientation="landscape" context-menu="enable" background-support="disable" encryption="disable" install-location="auto" hwkey-event="enable"/>
    <tizen:profile name="tv-samsung"/>
    <access origin="*" subdomains="true"/>

      <!-- Google Analytics -->
    <access origin="https://www.googletagmanager.com" subdomains="true"/>
    <access origin="https://www.google-analytics.com" subdomains="true"/>
    <access origin="https://analytics.google.com" subdomains="true"/>

    <!-- IMA SDK / Publicidad -->
    <access origin="https://imasdk.googleapis.com" subdomains="true"/>
    <access origin="https://pubads.g.doubleclick.net" subdomains="true"/>
    <access origin="https://securepubads.g.doubleclick.net" subdomains="true"/>
    <access origin="https://googleads.g.doubleclick.net" subdomains="true"/>
    <access origin="https://www.googleadservices.com" subdomains="true"/>
    <access origin="https://pagead2.googlesyndication.com" subdomains="true"/>
    <access origin="https://tpc.googlesyndication.com" subdomains="true"/>
    <access origin="https://rudo.video" subdomains="true"/>
</widget>
